---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  platform:         string;
  slug:             string;
  name:             string;
  shortDescription: string;
  date?:            string;
  featureImage?:    ImageMetadata;
}

const { platform, slug, name, shortDescription, date, featureImage } = Astro.props;
const href = `/files/${platform}/${slug}/`;
---

<a href={href} class="app-card">
  <div class="app-card-img">
    {featureImage
      ? <Image src={featureImage} alt={name} width={400} height={150} />
      : <div class="app-card-placeholder"><i class="fas fa-floppy-disk"></i></div>
    }
  </div>
  <div class="app-card-body">
    <h3 class="app-card-name">{name}</h3>
    {date && <span class="app-card-date">{date}</span>}
    <p class="app-card-desc">{shortDescription}</p>
  </div>
</a>

<style>
  .app-card {
    display: flex;
    flex-direction: column;
    border: 1px solid #e0e0e6;
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    text-decoration: none;
    color: inherit;
    transition: box-shadow .15s, border-color .15s;
  }
  .app-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.10); border-color: #ef5826; }

  .app-card-img { height: 150px; background: #f0f0f5; overflow: hidden; }
  .app-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .app-card-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    color: #ccc; font-size: 48px;
  }

  .app-card-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 4px; }

  .app-card-name {
    font-size: 15px; font-weight: 700; color: #222;
    margin: 0; line-height: 1.3;
  }
  .app-card:hover .app-card-name { color: #ef5826; }

  .app-card-date { font-size: 11px; color: #999; }

  .app-card-desc { font-size: 13px; color: #555; margin: 4px 0 0; line-height: 1.5; }
</style>
